# MongoDB
MONGODB_URL=mongodb://127.0.0.1:27017/imart

# NextAuth — local dev only; on Vercel, next.config.mjs auto-uses https://<your-vercel-domain>
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Legacy JWT (deprecated — only if old API clients remain)
JWT_SECRET=

# Cloudinary (image uploads)
CLOUD_NAME=
API_KEY=
API_SECRET=
# Alternate names also supported:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# SMTP — order confirmation & admin alerts (optional; checkout works without)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@imart.com
EMAIL_FROM=

# Support contact (shown on checkout success, help center, emails)
SUPPORT_EMAIL=support@imart.com
SUPPORT_PHONE=03001234567
NEXT_PUBLIC_SUPPORT_PHONE=03001234567

# Admin new-order email (optional)
ADMIN_ORDER_EMAIL=ops@imart.com

# Public site URL (sitemap, robots, OpenGraph)
# Production (Vercel): https://shien-beta.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# PayFast / GoPayFast — wired but disabled until ONLINE_PAYMENTS_ENABLED=true
ONLINE_PAYMENTS_ENABLED=false
# Get MERCHANT_ID + SECURED_KEY from PayFast merchant dashboard → Developer / SMTP & API
GOPAYFAST_MODE=sandbox
GOPAYFAST_MERCHANT_ID=
GOPAYFAST_SECURED_KEY=
GOPAYFAST_MERCHANT_NAME=iMART
# Sandbox defaults (override if PayFast gives different URLs):
# GOPAYFAST_API_BASE_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction
# GOPAYFAST_CHECKOUT_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
# Production:
# GOPAYFAST_MODE=production
# GOPAYFAST_API_BASE_URL=https://ipg.apps.net.pk/Ecommerce/api/Transaction
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Webhook URL to register in PayFast dashboard:
# https://your-domain.com/api/webhooks/payfast
# Optional: JSON initiate-payment API from some guides
# GOPAYFAST_USE_SIMPLE_API=false
# GOPAYFAST_INITIATE_URL=https://gopayfast.com
