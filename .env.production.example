# =============================================================================
# iMART — AWS / production environment
# =============================================================================
# 1. Copy this file on your EC2 server:
#      cp .env.production.example .env.production.local
# 2. Fill in YOUR_EC2_PUBLIC_IP (or your domain) everywhere marked below
# 3. Copy secrets from your local .env.local (MongoDB, AUTH_SECRET, Cloudinary, SMTP)
# 4. Never commit .env.production.local — it stays on the server only
# =============================================================================

NODE_ENV=production
PORT=5000

# MongoDB Atlas — paste the same MONGODB_URL from .env.local
MONGODB_URL=

# NextAuth
AUTH_SECRET=
AUTH_URL=http://YOUR_EC2_PUBLIC_IP
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://YOUR_EC2_PUBLIC_IP

# Legacy JWT (optional)
JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUD_NAME=
API_KEY=
API_SECRET=

# SMTP — Brevo (copy from .env.local)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Islamabad Mart <junaidalvi589@gmail.com>

ADMIN_ORDER_EMAIL=junaidalvi589@gmail.com
SUPPORT_EMAIL=support@imart.pk
SUPPORT_PHONE=03441882663
NEXT_PUBLIC_SUPPORT_PHONE=03441882663

# Public URLs — must match how users reach the site (no localhost)
NEXT_PUBLIC_SITE_URL=http://YOUR_EC2_PUBLIC_IP
SITE_URL=http://YOUR_EC2_PUBLIC_IP
NEXT_PUBLIC_APP_URL=http://YOUR_EC2_PUBLIC_IP

# PayFast (optional — COD works without this)
ONLINE_PAYMENTS_ENABLED=false
GOPAYFAST_MODE=sandbox
GOPAYFAST_MERCHANT_ID=
GOPAYFAST_SECURED_KEY=
GOPAYFAST_MERCHANT_NAME=iMart
